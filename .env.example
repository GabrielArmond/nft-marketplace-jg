# Base URL of the REST API. Same-origin path or absolute URL.
VITE_API_BASE_URL=/api

# Timeout for each HTTP request, in milliseconds (positive integer).
VITE_API_TIMEOUT_MS=10000

# Socket.IO origin. Empty means the page's own origin.
VITE_SOCKET_URL=

# Enables the MSW mock layer. `.env.demo` turns it on for dev:mocks and build:demo.
VITE_ENABLE_MOCKS=false
